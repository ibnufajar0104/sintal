<IfModule mod_rewrite.c>
    RewriteEngine On

    # Teruskan semua request yang bukan file/folder nyata ke index.php (CodeIgniter)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

# Jangan tampilkan daftar isi folder
Options -Indexes
